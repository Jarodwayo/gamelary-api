# Clé Steam Web API personnelle : https://steamcommunity.com/dev/apikey
# Ne jamais commiter le vrai .env (voir .gitignore) — sur Render, elle se
# configure dans l'onglet "Environment" du service, jamais dans le repo.
STEAM_API_KEY=

# Optionnel : liste blanche d'origines autorisées en CORS (séparées par une
# virgule). Vide = toutes origines acceptées (suffisant pour un projet solo
# sans donnée sensible autre que la clé, elle-même jamais exposée au
# client) — à restreindre si le projet grandit.
ALLOWED_ORIGINS=

PORT=3000
